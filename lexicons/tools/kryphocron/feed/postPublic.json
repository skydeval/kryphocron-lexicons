{
  "lexicon": 1,
  "id": "tools.kryphocron.feed.postPublic",
  "description": "Public-tier post. Field schema compatible with app.bsky.feed.post; consuming AppViews must include this NSID in their allowlist to index it. Substrate behavior: emit to public firehose, no audience-list consultation.",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["text", "createdAt"],
        "properties": {
          "text": {
            "type": "string",
            "description": "Post content.",
            "maxGraphemes": 300,
            "maxLength": 3000
          },
          "createdAt": {
            "type": "string",
            "format": "datetime",
            "description": "Time the post was created on the client."
          },
          "reply": {
            "type": "ref",
            "ref": "#replyRef",
            "description": "Optional parent and root post references."
          },
          "embed": {
            "type": "union",
            "refs": ["#embedImage", "#embedExternal", "#embedRecord"],
            "description": "Optional embed (image, external link, or quoted record)."
          },
          "facets": {
            "type": "array",
            "description": "Text annotations (mentions, links, tags).",
            "items": {
              "type": "ref",
              "ref": "#facet"
            }
          }
        }
      }
    },
    "replyRef": {
      "type": "object",
      "required": ["root", "parent"],
      "properties": {
        "root": {
          "type": "ref",
          "ref": "#strongRef"
        },
        "parent": {
          "type": "ref",
          "ref": "#strongRef"
        }
      }
    },
    "strongRef": {
      "type": "object",
      "required": ["uri", "cid"],
      "properties": {
        "uri": {
          "type": "string",
          "format": "at-uri"
        },
        "cid": {
          "type": "string",
          "format": "cid"
        }
      }
    },
    "embedImage": {
      "type": "object",
      "required": ["images"],
      "properties": {
        "images": {
          "type": "array",
          "items": {
            "type": "ref",
            "ref": "#image"
          },
          "maxLength": 4
        }
      }
    },
    "image": {
      "type": "object",
      "required": ["image", "alt"],
      "properties": {
        "image": {
          "type": "blob",
          "accept": ["image/*"],
          "maxSize": 2000000
        },
        "alt": {
          "type": "string",
          "description": "Alt-text for accessibility."
        },
        "aspectRatio": {
          "type": "ref",
          "ref": "#aspectRatio"
        }
      }
    },
    "embedGallery": {
      "type": "object",
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "description": "Gallery items. The schema ceiling of 20 is future-proofing; authoring clients should currently limit galleries to 10 items.",
          "items": {
            "type": "union",
            "refs": ["#galleryImage"]
          },
          "maxLength": 20
        }
      }
    },
    "galleryImage": {
      "type": "object",
      "required": ["image", "alt", "aspectRatio"],
      "properties": {
        "image": {
          "type": "blob",
          "accept": ["image/*"],
          "maxSize": 2000000
        },
        "alt": {
          "type": "string",
          "description": "Alt-text for accessibility."
        },
        "aspectRatio": {
          "type": "ref",
          "ref": "#aspectRatio"
        }
      }
    },
    "aspectRatio": {
      "type": "object",
      "description": "Width and height of an image or video. Only the ratio is meaningful; units are arbitrary.",
      "required": ["width", "height"],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "embedVideo": {
      "type": "object",
      "required": ["video"],
      "properties": {
        "video": {
          "type": "blob",
          "accept": ["video/mp4"],
          "maxSize": 300000000
        },
        "captions": {
          "type": "array",
          "items": {
            "type": "ref",
            "ref": "#caption"
          },
          "maxLength": 20
        },
        "alt": {
          "type": "string",
          "description": "Alt-text for accessibility."
        },
        "aspectRatio": {
          "type": "ref",
          "ref": "#aspectRatio"
        },
        "presentation": {
          "type": "string",
          "description": "Presentation hint for clients.",
          "knownValues": ["default", "gif"]
        }
      }
    },
    "caption": {
      "type": "object",
      "required": ["lang", "file"],
      "properties": {
        "lang": {
          "type": "string",
          "format": "language"
        },
        "file": {
          "type": "blob",
          "accept": ["text/vtt"],
          "maxSize": 20000
        }
      }
    },
    "embedExternal": {
      "type": "object",
      "required": ["external"],
      "properties": {
        "external": {
          "type": "ref",
          "ref": "#external"
        }
      }
    },
    "external": {
      "type": "object",
      "required": ["uri", "title", "description"],
      "properties": {
        "uri": {
          "type": "string",
          "format": "uri"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "thumb": {
          "type": "blob",
          "accept": ["image/*"],
          "maxSize": 1000000
        }
      }
    },
    "embedRecord": {
      "type": "object",
      "required": ["record"],
      "properties": {
        "record": {
          "type": "ref",
          "ref": "#strongRef"
        }
      }
    },
    "embedRecordWithMedia": {
      "type": "object",
      "required": ["record", "media"],
      "properties": {
        "record": {
          "type": "ref",
          "ref": "#embedRecord"
        },
        "media": {
          "type": "union",
          "refs": ["#embedImage", "#embedGallery", "#embedVideo", "#embedExternal"]
        }
      }
    },
    "selfLabels": {
      "type": "object",
      "description": "Content labels applied by the record's author.",
      "required": ["values"],
      "properties": {
        "values": {
          "type": "array",
          "items": {
            "type": "ref",
            "ref": "#selfLabel"
          },
          "maxLength": 10
        }
      }
    },
    "selfLabel": {
      "type": "object",
      "required": ["val"],
      "properties": {
        "val": {
          "type": "string",
          "description": "The label value.",
          "maxLength": 128
        }
      }
    },
    "facet": {
      "type": "object",
      "required": ["index", "features"],
      "properties": {
        "index": {
          "type": "ref",
          "ref": "#byteSlice"
        },
        "features": {
          "type": "array",
          "items": {
            "type": "union",
            "refs": ["#mention", "#link", "#tag"]
          }
        }
      }
    },
    "byteSlice": {
      "type": "object",
      "required": ["byteStart", "byteEnd"],
      "properties": {
        "byteStart": {
          "type": "integer",
          "minimum": 0
        },
        "byteEnd": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "mention": {
      "type": "object",
      "required": ["did"],
      "properties": {
        "did": {
          "type": "string",
          "format": "did"
        }
      }
    },
    "link": {
      "type": "object",
      "required": ["uri"],
      "properties": {
        "uri": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "tag": {
      "type": "object",
      "required": ["tag"],
      "properties": {
        "tag": {
          "type": "string",
          "maxGraphemes": 64,
          "maxLength": 640
        }
      }
    }
  }
}
