{
  "lexicon": 1,
  "id": "tools.kryphocron.feed.deletePostPrivate",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Delete a postPrivate record from the writer's own repository.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["repo", "rkey"],
          "properties": {
            "repo": {
              "type": "string",
              "format": "did",
              "description": "DID of the writer's repository. Must be the authenticated account."
            },
            "rkey": {
              "type": "string",
              "format": "record-key",
              "description": "Record key of the post to delete.",
              "maxLength": 512
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {}
        }
      },
      "errors": [
        {
          "name": "InvalidRequest",
          "description": "The request is malformed."
        },
        {
          "name": "Forbidden",
          "description": "The caller may not write to this repository, or the host does not allow this account private-tier writes."
        }
      ]
    }
  }
}
